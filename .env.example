# ── FHIR server ─────────────────────────────────────────────────────────────
# Public HAPI demo server (no auth required — great for demos):
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
# SMART Health IT open R4 sandbox (no creds needed, richer synthetic data):
# FHIR_BASE_URL=https://r4.smarthealthit.org
FHIR_TIMEOUT_S=30.0
FHIR_MAX_RESULTS=50

# ── HAPI validator sidecar ───────────────────────────────────────────────────
# Start with: docker-compose up hapi-validator
HAPI_VALIDATOR_URL=http://localhost:8082
HAPI_VALIDATOR_TIMEOUT_S=60.0

# ── MCP transport ────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio          # 'stdio' (Claude Desktop) or 'sse' (HTTP)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── Observability (LangFuse) — optional ─────────────────────────────────────
# Get keys from https://cloud.langfuse.com or your self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Postgres (eval dashboard, future use) ────────────────────────────────────
POSTGRES_USER=fhirmcp
POSTGRES_PASSWORD=fhirmcp
POSTGRES_DB=fhirmcp
DATABASE_URL=postgresql://fhirmcp:fhirmcp@localhost:5432/fhirmcp

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console           # 'console' (dev) or 'json' (production)

# ── SMART-on-FHIR (Epic/Cerner sandboxes) ────────────────────────────────────
# Register at https://fhir.epic.com or https://code.cerner.com to get credentials.
# Leave SMART_ENABLED=false to use the public HAPI/SMART-Health-IT server without auth.
SMART_ENABLED=false
SMART_CLIENT_ID=
SMART_CLIENT_SECRET=
# SMART_TOKEN_URL=          # optional — auto-discovered from FHIR_BASE_URL if blank
SMART_SCOPES=system/*.read
SMART_GRANT_TYPE=client_credentials
SMART_TOKEN_TIMEOUT_S=15.0
